+/**
+ * Add the AI opponent (room master only, 1v1 without teams). The bot is owned by the requesting client,
+ * so it leaves with them, and it is ready immediately.
+ *
+ * @param {SocketClient} client
+ * @param {Object} data
+ * @param {Function} callback
+ */
+RoomController.prototype.onAddBot = function(client, data, callback)
+{
+    var controller = this,
+        check = function () {
+            if (!controller.roomMaster || controller.roomMaster.id !== client.id) { return 'Only the room master can add the AI.'; }
+            if (controller.room.game || controller.launching) { return 'Game already started.'; }
+            if (controller.room.config.teams) { return 'The AI does not play team games.'; }
+            if (controller.room.players.count() !== 1) { return 'The AI plays 1v1: it needs exactly one other player.'; }
+            if (!controller.clients.exists(client)) { return 'Unknown client'; }
+            return null;
+        },
+        error = check();
+
+    if (error) { return callback({success: false, error: error}); }
+
+    CurvyrlBots.load().then(function (model) {
+        var error = model ? check() : 'AI opponent unavailable.';
+
+        if (error) { return callback({success: false, error: error}); }
+
+        var name = 'AI';
+
+        while (!controller.room.isNameAvailable(name)) { name += '+'; }
+
+        var player = new Player(client, name, '#7fdbff');
+
+        player.isBot = true;
+
+        if (!controller.room.addPlayer(player)) {
+            return callback({success: false, error: 'Could not add player.'});
+        }
+
+        client.players.add(player);
+        controller.emit('player:add', { room: controller.room, player: player});
+        player.toggleReady(true);
+        controller.socketGroup.addEvent('player:ready', { player: player.id, ready: true });
+        callback({success: true});
+
+        if (controller.room.isReady()) {
+            controller.launch();
+        }
+    });
+};
+
+/**
+ * Remove the AI opponent(s) added by this client
+ *
+ * @param {SocketClient} client
+ * @param {Object} data
+ * @param {Function} callback
+ */
+RoomController.prototype.onRemoveBot = function(client, data, callback)
+{
+    if (this.room.game) { return callback({success: false, error: 'Game already started.'}); }
+
+    for (var i = client.players.items.length - 1; i >= 0; i--) {
+        if (client.players.items[i].isBot) {
+            this.removePlayer(client.players.items[i]);
+        }
+    }
+
+    callback({success: true});
+};
+
 /**
  * On remove player from room
  *
diff --git a/src/server/core/CurvyrlBots.js b/src/server/core/CurvyrlBots.js
new file mode 100644
index 0000000..c9efa8f
--- /dev/null
+++ b/src/server/core/CurvyrlBots.js
@@ -0,0 +1,70 @@
+/**
+ * AI opponents from curvyrl: an ONNX policy trained with PPO self-play.
+ * The bot code and model live in CURVYRL_BOT_DIR (default: <repo>/bot), see bot/bot.cjs.
+ */
+var CurvyrlBots = {
+    lib: null,
+    model: null,
+    loading: null
+};
+
+CurvyrlBots.dir = function()
+{
+    return process.env.CURVYRL_BOT_DIR || require('path').join(__dirname, '..', 'bot');
+};
+
+/**
+ * Load the bot library and model once; resolves to the loaded model, or null if unavailable.
+ *
+ * @return {Promise}
+ */
+CurvyrlBots.load = function()
+{
+    if (!this.loading) {
+        var path = require('path');
+
+        try {
+            this.lib = require(path.join(this.dir(), 'bot.cjs'));
+            this.lib.CurvyBot.installHooks({ Bonus: Bonus });
+            this.loading = this.lib.CurvyBot.load(path.join(this.dir(), 'model')).then(function (model) {
+                CurvyrlBots.model = model;
+                console.info('AI opponent loaded (update %s, %s).', model.meta.update, model.meta.model);
+                return model;
+            }, function (error) {
+                console.error('AI opponent unavailable:', error);
+                return null;
+            });
+        } catch (error) {
+            console.error('AI opponent unavailable:', error);
+            this.loading = Promise.resolve(null);
+        }
+    }
+
+    return this.loading;
+};
+
+/**
+ * Create bots for a game's bot players (the model must already be loaded).
+ *
+ * @param {Game} game
+ *
+ * @return {Array}
+ */
+CurvyrlBots.forGame = function(game)
+{
+    var bots = [];
+
+    if (!this.model) { return bots; }
+
+    for (var i = 0; i < game.avatars.items.length; i++) {
+        var avatar = game.avatars.items[i];
+
+        if (avatar.player.isBot) {
+            var bot = new this.lib.CurvyBot(this.model.meta, this.model.session, this.model.ort);
+            bot.attach(game, avatar);
+            bots.push(bot);
+        }
+    }
+
+    return bots;
+};
