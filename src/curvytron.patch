+/**
+ * Poll the lobby for rooms and emit changes
+ */
+RoomsRepository.prototype.pollRooms = function()
+{
+    var repository = this,
+        request = new XMLHttpRequest();
+
+    request.open('GET', 'rooms', true);
+    request.onload = function()
+    {
+        if (!repository.polling || request.status !== 200) {
+            return;
+        }
+
+        var rooms;
+
+        try {
+            rooms = JSON.parse(request.responseText);
+        } catch (error) {
+            return;
+        }
+
+        var previous = repository.rooms.items.slice();
+
+        for (var i = 0; i < previous.length; i++) {
+            if (!rooms.some(function (room) { return room.name === previous[i].name; })) {
+                repository.onRoomClose({detail: {name: previous[i].name}});
+            }
+        }
+
+        for (var j = 0; j < rooms.length; j++) {
+            var room = rooms[j],
+                existing = repository.get(room.name);
+
+            if (!existing) {
+                repository.onRoomOpen({detail: room});
+                continue;
+            }
+
+            if (existing.players !== room.players) {
+                repository.onRoomPlayers({detail: {name: room.name, players: room.players}});
+            }
+
+            if (existing.game !== room.game) {
+                repository.onRoomGame({detail: {name: room.name, game: room.game}});
+            }
+
+            if (existing.open !== room.open) {
+                repository.onRoomConfigOpen({detail: {name: room.name, open: room.open}});
+            }
+        }
+    };
+    request.send();
+};
+
