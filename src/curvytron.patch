  * Start
  */
 RoomsRepository.prototype.start = function()
 {
+    if (window.CURVYTRON_LOBBY && window.CURVYTRON_LOBBY.isLobby) {
+        this.attachEvents();
+        this.polling = true;
+        this.pollRooms();
+        this.poll = setInterval(this.pollRooms, 2000);
+
+        return;
+    }
+
     if (this.client.connected) {
         this.attachEvents();
         this.client.addEvent('room:fetch');
@@ -195,6 +263,12 @@ RoomsRepository.prototype.start = function()
  */
