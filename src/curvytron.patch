+/**
+ * Serve the Modal lobby URL to the client
+ *
+ * @param {Object} request
+ * @param {Object} response
+ */
+Server.prototype.serveModalConfig = function(request, response)
+{
+    var config = this.lobbyUrl ? {isLobby: false, url: this.lobbyUrl} : null;
+
+    response.set('Cache-Control', 'no-store');
+    response.type('application/javascript');
+    response.send('window.CURVYTRON_LOBBY = ' + JSON.stringify(config) + ';');
+};
+
+/**
+ * Get a room's public state
+ *
+ * @param {Object} request
+ * @param {Object} response
+ */
+Server.prototype.getRoom = function(request, response)
+{
+    var room = this.roomRepository.get(request.params.name);
+
+    if (!room) {
+        return response.status(404).end();
+    }
+
+    response.json(room.serialize(false));
+};
+
+/**
+ * Create a room unless it already exists
+ *
+ * @param {Object} request
+ * @param {Object} response
+ */
+Server.prototype.ensureRoom = function(request, response)
+{
+    var name = request.params.name.substr(0, BaseRoom.prototype.maxLength).trim();
+
+    if (!name) {
+        return response.status(400).end();
+    }
+
+    if (this.roomRepository.get(name)) {
+        return response.status(200).end();
+    }
+
+    response.status(this.roomRepository.create(name) ? 201 : 409).end();
+};
