+/**
+ * Draw text scaled
+ *
+ * @param {String} text
+ * @param {Number} x
+ * @param {Number} y
+ * @param {String} color
+ */
+Canvas.prototype.drawText = function(text, x, y, color)
+{
+    var context = this.context,
+        padding = 2,
+        fontSize = Math.max(12, Math.min(20, 14 * this.element.width / 800)),
+        textWidth,
+        scaledX = this.round(x * this.scale),
+        scaledY = this.round(y * this.scale),
+        offset = this.round(2 * this.scale);
+
+    context.save();
+    context.font = 'bold ' + fontSize + 'px "Lato", "Helvetica Neue", "Helvetica", sans-serif';
+    context.textAlign = 'center';
+    context.textBaseline = 'bottom';
+
+    textWidth = context.measureText(text).width;
+    if (textWidth + padding * 2 > this.element.width) {
+        fontSize *= Math.max(1, this.element.width - padding * 2) / textWidth;
+        context.font = 'bold ' + fontSize + 'px "Lato", "Helvetica Neue", "Helvetica", sans-serif';
+        textWidth = context.measureText(text).width;
+    }
+
+    scaledX = Math.max(
+        textWidth / 2 + padding,
+        Math.min(this.element.width - textWidth / 2 - padding, scaledX)
+    );
+    scaledY -= offset;
+
+    if (scaledY - fontSize < 0) {
+        scaledY = this.round(y * this.scale) + offset + fontSize;
+    }
+
+    context.lineWidth = Math.max(2, fontSize / 8);
+    context.lineJoin = 'round';
+    context.strokeStyle = '#222222';
+    context.strokeText(text, scaledX, scaledY);
+    context.fillStyle = color;
+    context.fillText(text, scaledX, scaledY);
+    context.restore();
+};
+
