diff --git a/src/server/core/CurvyrlBots.js b/src/server/core/CurvyrlBots.js
new file mode 100644
index 0000000..7a0fc94
--- /dev/null
+++ b/src/server/core/CurvyrlBots.js
@@ -0,0 +1,71 @@
+/**
+ * AI opponents from curvyrl: an ONNX policy trained with PPO self-play.
+ * The bot code and model live in CURVYRL_BOT_DIR (default: <repo>/bot), see bot/bot.cjs.
+ */
+var CurvyrlBots = {
+    lib: null,
+    model: null,
+    loading: null,
+    max: 8
+};
+
+CurvyrlBots.dir = function()
+{
+    return process.env.CURVYRL_BOT_DIR || require('path').join(__dirname, '..', 'bot');
+};
+
+/**
+ * Load the bot library and model once; resolves to the loaded model, or null if unavailable.
+ *
+ * @return {Promise}
+ */
+CurvyrlBots.load = function()
+{
+    if (!this.loading) {
+        var path = require('path');
+
+        try {
+            this.lib = require(path.join(this.dir(), 'bot.cjs'));
+            this.lib.CurvyBot.installHooks({ Bonus: Bonus });
+            this.loading = this.lib.CurvyBot.load(path.join(this.dir(), 'model')).then(function (model) {
+                CurvyrlBots.model = model;
+                console.info('AI opponent loaded (update %s, %s).', model.meta.update, model.meta.model);
+                return model;
+            }, function (error) {
+                console.error('AI opponent unavailable:', error);
+                return null;
+            });
+        } catch (error) {
+            console.error('AI opponent unavailable:', error);
+            this.loading = Promise.resolve(null);
+        }
+    }
+
+    return this.loading;
+};
+
+/**
+ * Create bots for a game's bot players (the model must already be loaded).
+ *
+ * @param {Game} game
+ *
+ * @return {Array}
+ */
+CurvyrlBots.forGame = function(game)
+{
+    var bots = [];
+
+    if (!this.model) { return bots; }
+
+    for (var i = 0; i < game.avatars.items.length; i++) {
+        var avatar = game.avatars.items[i];
+
+        if (avatar.player.isBot) {
+            var bot = new this.lib.CurvyBot(this.model.meta, this.model.session, this.model.ort);
+            bot.attach(game, avatar);
+            bots.push(bot);
+        }
+    }
+
+    return bots;
+};
