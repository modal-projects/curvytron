diff --git a/src/client/model/AvatarPredictor.js b/src/client/model/AvatarPredictor.js
new file mode 100644
index 0000000..16544c9
--- /dev/null
+++ b/src/client/model/AvatarPredictor.js
@@ -0,0 +1,289 @@
+/**
+ * Avatar predictor
+ *
+ * Client-side prediction with rollback for a local avatar: the last authoritative
+ * server state is rewound to and re-simulated with the local inputs the server has
+ * not acknowledged yet, so the local avatar reacts to input immediately.
+ *
+ * @param {Avatar} avatar
+ */
+function AvatarPredictor(avatar)
+{
+    this.avatar   = avatar;
+    this.inputs   = [];
+    this.sequence = 0;
+    this.delay    = null;
+    this.path     = [];
+    this.errorX   = 0;
+    this.errorY   = 0;
+    this.lastTime = null;
+    this.game     = null;
+
+    this.reset();
+}
+
+/**
+ * Simulation step (ms), the server frame duration
+ *
+ * @type {Number}
+ */
+AvatarPredictor.prototype.step = 1000/60;
+
+/**
+ * Maximum prediction horizon (ms)
+ *
+ * @type {Number}
+ */
+AvatarPredictor.prototype.maxHorizon = 300;
+
+/**
+ * Correction smoothing time constant (ms)
+ *
+ * @type {Number}
+ */
+AvatarPredictor.prototype.smoothing = 80;
+
+/**
+ * Corrections larger than this distance are applied instantly
+ *
+ * @type {Number}
+ */
+AvatarPredictor.prototype.snapDistance = 4;
+
+/**
+ * Current time (ms)
+ *
+ * @return {Number}
+ */
+AvatarPredictor.prototype.now = function()
+{
+    return window.performance ? window.performance.now() : new Date().getTime();
+};
+
+/**
+ * Reset the authoritative state (new round)
+ */
+AvatarPredictor.prototype.reset = function()
+{
+    this.server = null;
+    this.angle  = null;
+    this.move   = 0;
+    this.errorX = 0;
+    this.errorY = 0;
+    this.path.length = 0;
+};
+
+/**
+ * Record a local input
+ *
+ * @param {Number} move
+ *
+ * @return {Number} Input sequence number
+ */
+AvatarPredictor.prototype.addInput = function(move)
+{
+    this.sequence++;
+    this.inputs.push({sequence: this.sequence, move: move, time: this.now()});
+
+    return this.sequence;
+};
+
+/**
+ * Set the measured round trip latency (ms)
+ *
+ * @param {Number} latency
+ */
+AvatarPredictor.prototype.setLatency = function(latency)
+{
+    if (this.delay === null && latency > 0) {
+        this.delay = latency;
+    }
+};
+
+/**
+ * On server angle
+ *
+ * @param {Number} angle
+ */
+AvatarPredictor.prototype.onServerAngle = function(angle)
+{
+    this.angle = angle;
+};
+
+/**
+ * On server position
+ *
+ * @param {Number} x
+ * @param {Number} y
+ * @param {Number} sequence Last input sequence applied by the server
+ */
+AvatarPredictor.prototype.onServerPosition = function(x, y, sequence)
+{
+    var now      = this.now(),
+        previous = this.server ? this.simulate(now, false) : null,
+        input;
+
+    while (this.inputs.length && typeof(sequence) === 'number' && this.inputs[0].sequence <= sequence) {
+        input = this.inputs.shift();
+        this.move = input.move;
+
+        if (input.sequence === sequence) {
+            this.addDelaySample(now - input.time);
+        }
+    }
+
+    this.server = {
+        x: x,
+        y: y,
+        angle: this.angle !== null ? this.angle : this.avatar.angle,
+        time: now
+    };
+
+    if (previous) {
+        var current = this.simulate(now, false),
+            errorX  = this.errorX + previous.x - current.x,
+            errorY  = this.errorY + previous.y - current.y;
+
+        if (Math.sqrt(errorX * errorX + errorY * errorY) > this.snapDistance) {
+            errorX = 0;
+            errorY = 0;
+        }
+
+        this.errorX = errorX;
+        this.errorY = errorY;
+    }
+};
+
+/**
+ * Add a latency sample (time between an input and its acknowledgement)
+ *
+ * @param {Number} sample
+ */
+AvatarPredictor.prototype.addDelaySample = function(sample)
+{
+    this.delay = this.delay === null ? sample : this.delay * 0.8 + sample * 0.2;
+};
+
+/**
+ * Can a prediction be made?
+ *
+ * @return {Boolean}
+ */
+AvatarPredictor.prototype.isActive = function()
+{
+    return this.server !== null && this.avatar.alive;
+};
+
+/**
+ * Predict the avatar state for the current frame
+ *
+ * @return {Object}
+ */
+AvatarPredictor.prototype.predict = function()
+{
+    var now   = this.now(),
+        state = this.simulate(now, this.avatar.printing),
+        decay = this.lastTime === null ? 1 : Math.exp(-(now - this.lastTime) / this.smoothing);
+
+    this.lastTime = now;
+    this.errorX  *= decay;
+    this.errorY  *= decay;
+
+    state.x += this.errorX;
+    state.y += this.errorY;
+
+    if (this.path.length) {
+        this.path[this.path.length - 1] = [state.x, state.y];
+    }
+
+    return state;
+};
+
+/**
+ * Re-simulate from the authoritative state to the given time
+ *
+ * The server sees an input about half a round trip after it was sent, and its state
+ * reaches us another half round trip later: the predicted state is the server state
+ * advanced by one round trip plus the time elapsed since it was received.
+ *
+ * @param {Number} now
+ * @param {Boolean} trace Record the simulated path
+ *
+ * @return {Object}
+ */
+AvatarPredictor.prototype.simulate = function(now, trace)
+{
+    var avatar   = this.avatar,
+        server   = this.server,
+        delay    = this.delay || 0,
+        horizon  = Math.min(now - server.time + delay, this.maxHorizon),
+        velocity = avatar.velocity / 1000,
+        x        = server.x,
+        y        = server.y,
+        angle    = server.angle,
+        angular  = this.getAngularVelocity(this.move),
+        size     = this.game ? this.game.size : null,
+        wrap     = this.game ? this.game.borderless : false,
+        next     = 0,
+        time     = 0,
+        input, dt, at;
+
+    if (trace) {
+        this.path.length = 0;
+        this.path.push([x, y]);
+    }
+
+    while (time < horizon) {
+        dt = Math.min(this.step, horizon - time);
+
+        while (next < this.inputs.length) {
+            input = this.inputs[next];
+            at    = Math.max(0, input.time + delay - server.time);
+
+            if (at > time) { break; }
+
+            angular = this.getAngularVelocity(input.move);
+            next++;
+        }
+
+        if (angular) {
+            if (avatar.directionInLoop) {
+                angle += angular * dt;
+            } else {
+                angle  += angular;
+                angular = 0;
+            }
+        }
+
+        x += Math.cos(angle) * velocity * dt;
+        y += Math.sin(angle) * velocity * dt;
+
+        if (wrap && size) {
+            if (x < 0 || x > size || y < 0 || y > size) {
+                x = (x + size) % size;
+                y = (y + size) % size;
+                if (trace) { this.path.length = 0; }
+            }
+        }
+
+        if (trace) {
+            this.path.push([x, y]);
+        }
+
+        time += dt;
+    }
+
+    return {x: x, y: y, angle: angle};
+};
+
+/**
+ * Angular velocity for the given move, mirroring BaseAvatar.updateAngularVelocity
+ *
+ * @param {Number} move
+ *
+ * @return {Number}
+ */
+AvatarPredictor.prototype.getAngularVelocity = function(move)
+{
+    return (move || 0) * this.avatar.angularVelocityBase * (this.avatar.inverse ? -1 : 1);
+};
