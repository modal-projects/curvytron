From 96bd2177181ef84c132cf4848412eba4754f1a6f Mon Sep 17 00:00:00 2001
From: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
Date: Sun, 18 Oct 2026 17:14:39 +0000
Subject: [PATCH 2/6] Improve mobile touch controls and show scoreboard between
 rounds

- Replace removed document.createTouch() with a string touch binding (touch controls threw on modern browsers)
- Register non-passive touch listeners (incl. touchmove) so preventDefault() suppresses long-press selection, callouts and scrolling
- Disable text selection, touch callouts, tap highlight and browser gestures in the game view
- Use clientX/innerWidth for left/right halves
- Show a live scoreboard in the round recap on small screens

Co-Authored-By: Akshat Bubna <akshatb42@gmail.com>
---
 src/client/controller/game/RoundController.js | 16 ++++-
 src/client/model/Player.js                    |  2 +-
 src/client/model/PlayerInput.js               | 65 +++++++++++++++----
 src/client/views/game/play.html               |  9 +++
 src/sass/helpers/_responsive.scss             | 54 +++++++++++++++
 src/sass/pages/_game.scss                     | 10 +++
 src/vendor/key-mapper.js                      | 16 ++---
 7 files changed, 148 insertions(+), 24 deletions(-)

diff --git a/src/client/controller/game/RoundController.js b/src/client/controller/game/RoundController.js
index 4b10ae3..aad41d9 100644
--- a/src/client/controller/game/RoundController.js
+++ b/src/client/controller/game/RoundController.js
@@ -27,11 +27,13 @@ function RoundController($scope, repository, notifier)
     this.updateBorders = this.updateBorders.bind(this);
     this.onEnd         = this.onEnd.bind(this);
     this.onWarmup      = this.onWarmup.bind(this);
+    this.updateStandings = this.updateStandings.bind(this);
     this.endWarmup     = this.endWarmup.bind(this);
     this.detachEvents  = this.detachEvents.bind(this);
 
     this.$scope.roundWinner = null;
     this.$scope.gameWinner  = null;
+    this.$scope.standings   = [];
 
     this.$scope.$on('$destroy', this.detachEvents);
 
@@ -91,9 +93,21 @@ RoundController.prototype.onRoundEnd = function(e)
     this.notifier.notifyInactive(this.game.roundWinner ? this.game.roundWinner.name + ' won round!' : 'Round end!');
 
     this.$scope.winner = this.game.roundWinner ? this.game.roundWinner : false;
-    this.digestScope();
+    this.updateStandings();
 
     this.endElement.style.display = 'block';
+
+    // Round scores may arrive in the same network batch, right after the round end event.
+    setTimeout(this.updateStandings, 100);
+};
+
+/**
+ * Update the between-round scoreboard
+ */
+RoundController.prototype.updateStandings = function()
+{
+    this.$scope.standings = this.game.sortAvatars(this.game.avatars.filter(function () { return true; })).items;
+    this.digestScope();
 };
 
