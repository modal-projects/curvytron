+ * Listeners must be non-passive so preventDefault() suppresses long-press selection, callouts and scrolling.
+ *
+ * @type {Array}
+ */
+PlayerInput.prototype.touchEvents = ['touchstart', 'touchmove', 'touchend', 'touchcancel'];
+
 /**
  * Attach events
  */
@@ -50,10 +58,10 @@ PlayerInput.prototype.attachEvents = function()
                 window.addEventListener('keydown', this.onKeyDown);
                 window.addEventListener('keyup', this.onKeyUp);
             } else if (type === 'touch') {
-                window.addEventListener('touchstart', this.onTouch);
-                window.addEventListener('touchend', this.onTouch);
-                window.addEventListener('touchleave', this.onTouch);
-                window.addEventListener('touchcancel', this.onTouch);
+                for (var e = this.touchEvents.length - 1; e >= 0; e--) {
+                    window.addEventListener(this.touchEvents[e], this.onTouch, {passive: false});
+                }
+                window.addEventListener('contextmenu', this.preventDefault);
             } else if (new RegExp('^gamepad:\\d+:button').test(type)) {
                 gamepadListener.on(type, this.onButton);
             } else {
@@ -82,10 +90,10 @@ PlayerInput.prototype.detachEvents = function()
                 window.removeEventListener('keydown', this.onKeyDown);
                 window.removeEventListener('keyup', this.onKeyUp);
             } else if (type === 'touch') {
-                window.removeEventListener('touchstart', this.onTouch);
-                window.removeEventListener('touchend', this.onTouch);
-                window.removeEventListener('touchleave', this.onTouch);
-                window.removeEventListener('touchcancel', this.onTouch);
+                for (var e = this.touchEvents.length - 1; e >= 0; e--) {
+                    window.removeEventListener(this.touchEvents[e], this.onTouch, {passive: false});
+                }
+                window.removeEventListener('contextmenu', this.preventDefault);
             } else if (new RegExp('^gamepad:\\d+:button').test(type)) {
                 gamepadListener.off(type, this.onButton);
             } else {
@@ -95,6 +103,35 @@ PlayerInput.prototype.detachEvents = function()
     }
 };
 
+/**
+ * Prevent default browser behaviour (long-press context menu)
+ *
+ * @param {Event} e
+ */
+PlayerInput.prototype.preventDefault = function(e)
+{
+    e.preventDefault();
+};
+
+/**
+ * Is the given binding a touch binding?
+ *
+ * @param {*} binding
+ *
+ * @return {Boolean}
+ */
+PlayerInput.isTouchBinding = function(binding)
+{
+    return binding === PlayerInput.TOUCH || (typeof(Touch) !== 'undefined' && binding instanceof Touch);
+};
+
+/**
+ * Touch binding value
+ *
+ * @type {String}
+ */
+PlayerInput.TOUCH = 'touch';
+
 /**
  * Get binding type
  *
@@ -104,7 +141,7 @@ PlayerInput.prototype.detachEvents = function()
  */
 PlayerInput.prototype.getBindingType = function(binding)
 {
-    if (typeof(Touch) !== 'undefined' && binding instanceof Touch) {
+    if (PlayerInput.isTouchBinding(binding)) {
         return 'touch';
     }
 
@@ -182,21 +219,23 @@ PlayerInput.prototype.onButton = function(e)
  */
 PlayerInput.prototype.onTouch = function(e)
 {
-    e.preventDefault();
+    if (e.cancelable) {
+        e.preventDefault();
+    }
 
-    var center = this.width/2,
+    var center = (this.width || window.innerWidth)/2,
         tests = [],
         t, i, x;
 
     for (i = this.binding.length - 1; i >= 0; i--) {
-        if (this.binding[i] instanceof Touch) {
+        if (PlayerInput.isTouchBinding(this.binding[i])) {
             tests.push({index: i, result: false});
         }
     }
 
     for (i = e.touches.length - 1; i >= 0; i--) {
         for (t = tests.length - 1; t >= 0; t--) {
-            x = e.touches[i].screenX;
+            x = e.touches[i].clientX;
             if (tests[t].index === 0 ? x < center : x >= center) {
                 tests[t].result = true;
             }
