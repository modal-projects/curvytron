diff --git a/src/client/core/RtcClient.js b/src/client/core/RtcClient.js
new file mode 100644
index 0000000..9a7cfe7
--- /dev/null
+++ b/src/client/core/RtcClient.js
@@ -0,0 +1,186 @@
+/**
+ * WebRTC client
+ *
+ * Opens data channels to the server, negotiated over the WebSocket: game state is
+ * received on an unreliable unordered channel and inputs are sent on a reliable
+ * ordered channel. Everything falls back to the WebSocket until the channels open.
+ *
+ * @param {SocketClient} client
+ */
+function RtcClient(client)
+{
+    this.client     = client;
+    this.connection = null;
+    this.state      = null;
+    this.input      = null;
+    this.sequence   = 0;
+
+    this.onAnswer      = this.onAnswer.bind(this);
+    this.onCandidate   = this.onCandidate.bind(this);
+    this.onUnavailable = this.onUnavailable.bind(this);
+    this.onState       = this.onState.bind(this);
+
+    this.client.on('rtc:answer', this.onAnswer);
+    this.client.on('rtc:candidate', this.onCandidate);
+    this.client.on('rtc:unavailable', this.onUnavailable);
+}
+
+/**
+ * Is WebRTC supported by the browser?
+ *
+ * @return {Boolean}
+ */
+RtcClient.isSupported = function()
+{
+    return typeof(window.RTCPeerConnection) === 'function';
+};
+
+/**
+ * ICE servers
+ *
+ * @type {Array}
+ */
+RtcClient.prototype.iceServers = [{urls: 'stun:stun.l.google.com:19302'}];
+
+/**
+ * Start negotiation
+ */
+RtcClient.prototype.start = function()
+{
+    var client = this.client,
+        connection;
+
+    try {
+        connection = new RTCPeerConnection({iceServers: this.iceServers});
+    } catch (error) {
+        console.warn('WebRTC unavailable: %s', error);
+        return;
+    }
+
+    this.connection = connection;
+    this.state      = connection.createDataChannel('state', {ordered: false, maxRetransmits: 0});
+    this.input      = connection.createDataChannel('input', {ordered: true});
+
+    this.state.onmessage = this.onState;
+    this.state.onopen    = function () { console.info('WebRTC data channels open.'); };
+
+    connection.onicecandidate = function (e) {
+        if (e.candidate && e.candidate.candidate) {
+            client.addEvent('rtc:candidate', {candidate: e.candidate.candidate, mid: e.candidate.sdpMid}, null, true);
+        }
+    };
+
+    connection.createOffer()
+        .then(function (offer) { return connection.setLocalDescription(offer); })
+        .then(function () {
+            client.addEvent('rtc:offer', {sdp: connection.localDescription.sdp, type: connection.localDescription.type}, null, true);
+        })
+        .catch(this.onUnavailable);
+};
+
+/**
+ * On answer
+ *
+ * @param {Event} e
+ */
+RtcClient.prototype.onAnswer = function(e)
+{
+    if (this.connection && e.detail) {
+        this.connection.setRemoteDescription({sdp: e.detail.sdp, type: e.detail.type}).catch(this.onUnavailable);
+    }
+};
+
+/**
+ * On remote candidate
+ *
+ * @param {Event} e
+ */
+RtcClient.prototype.onCandidate = function(e)
+{
+    if (this.connection && e.detail && e.detail.candidate) {
+        this.connection.addIceCandidate({candidate: e.detail.candidate, sdpMid: e.detail.mid}).catch(function (error) {
+            console.warn('WebRTC candidate error: %s', error);
+        });
+    }
+};
+
+/**
+ * On state packet: [sequence, events]. Out of date packets are dropped.
+ *
+ * @param {MessageEvent} e
+ */
+RtcClient.prototype.onState = function(e)
+{
+    var packet = JSON.parse(e.data);
+
+    if (packet[0] > this.sequence) {
+        this.sequence = packet[0];
+        this.client.handleEvents(packet[1]);
+    }
+};
+
+/**
+ * Send events on the input channel
+ *
+ * @param {Array} events
+ *
+ * @return {Boolean} Whether the events were sent
+ */
+RtcClient.prototype.sendInput = function(events)
+{
+    if (this.input && this.input.readyState === 'open') {
+        this.input.send(JSON.stringify(events));
+        return true;
+    }
+
+    return false;
+};
+
+/**
+ * Is the state channel open?
+ *
+ * @return {Boolean}
+ */
+RtcClient.prototype.isOpen = function()
+{
+    return this.state !== null && this.state.readyState === 'open';
+};
+
+/**
+ * On unavailable
+ *
+ * @param {*} error
+ */
+RtcClient.prototype.onUnavailable = function(error)
+{
+    if (error && error.message) {
+        console.warn('WebRTC unavailable: %s', error.message);
+    }
+
+    this.close();
+};
+
+/**
+ * Close
+ */
+RtcClient.prototype.close = function()
+{
+    if (this.connection) {
+        this.connection.close();
+    }
+
+    this.connection = null;
+    this.state      = null;
+    this.input      = null;
+};
+
+/**
+ * Destroy
+ */
+RtcClient.prototype.destroy = function()
+{
+    this.close();
+    this.client.off('rtc:answer', this.onAnswer);
+    this.client.off('rtc:candidate', this.onCandidate);
+    this.client.off('rtc:unavailable', this.onUnavailable);
+};
