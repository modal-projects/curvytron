diff --git a/src/server/core/RtcPeer.js b/src/server/core/RtcPeer.js
new file mode 100644
index 0000000..d5b2f64
--- /dev/null
+++ b/src/server/core/RtcPeer.js
@@ -0,0 +1,201 @@
+/**
+ * WebRTC peer for a socket client
+ *
+ * Negotiated over the WebSocket. Carries frequent, latency-sensitive game state on an
+ * unreliable unordered data channel ("state", server to client) and player inputs on a
+ * reliable ordered data channel ("input", client to server). The WebSocket stays the
+ * fallback and carries everything else.
+ *
+ * @param {SocketClient} client
+ */
+function RtcPeer(client)
+{
+    this.client     = client;
+    this.connection = null;
+    this.state      = null;
+    this.events     = [];
+    this.sequence   = 0;
+
+    this.onOffer     = this.onOffer.bind(this);
+    this.onCandidate = this.onCandidate.bind(this);
+
+    this.client.on('rtc:offer', this.onOffer);
+    this.client.on('rtc:candidate', this.onCandidate);
+}
+
+/**
+ * Is WebRTC available on this server?
+ *
+ * @return {Boolean}
+ */
+RtcPeer.isAvailable = function()
+{
+    return nodeDataChannel !== false && process.env.CURVYTRON_WEBRTC !== '0';
+};
+
+/**
+ * ICE servers
+ *
+ * @type {Array}
+ */
+RtcPeer.prototype.iceServers = (process.env.CURVYTRON_ICE_SERVERS || 'stun:stun.l.google.com:19302').split(',');
+
+/**
+ * Inputs accepted on the input channel
+ *
+ * @type {Array}
+ */
+RtcPeer.prototype.inputEvents = ['player:move'];
+
+/**
+ * On offer
+ *
+ * @param {Object} data
+ */
+RtcPeer.prototype.onOffer = function(data)
+{
+    if (!RtcPeer.isAvailable() || !data || typeof(data.sdp) !== 'string') {
+        return this.client.addEvent('rtc:unavailable');
+    }
+
+    this.close();
+
+    var client     = this.client,
+        connection = new nodeDataChannel.PeerConnection('client-' + client.id, {iceServers: this.iceServers});
+
+    this.connection = connection;
+
+    connection.onLocalDescription(function (sdp, type) {
+        client.addEvent('rtc:answer', {sdp: sdp, type: type}, null, true);
+    });
+
+    connection.onLocalCandidate(function (candidate, mid) {
+        client.addEvent('rtc:candidate', {candidate: candidate, mid: mid}, null, true);
+    });
+
+    connection.onDataChannel(this.onDataChannel.bind(this));
+
+    try {
+        connection.setRemoteDescription(data.sdp, data.type || 'offer');
+    } catch (error) {
+        console.error('WebRTC offer error: %s', error);
+        this.close();
+    }
+};
+
+/**
+ * On remote candidate
+ *
+ * @param {Object} data
+ */
+RtcPeer.prototype.onCandidate = function(data)
+{
+    if (this.connection && data && data.candidate) {
+        try {
+            this.connection.addRemoteCandidate(data.candidate, data.mid || '0');
+        } catch (error) {
+            console.error('WebRTC candidate error: %s', error);
+        }
+    }
+};
+
+/**
+ * On data channel
+ *
+ * @param {DataChannel} channel
+ */
+RtcPeer.prototype.onDataChannel = function(channel)
+{
+    var peer = this;
+
+    if (channel.getLabel() === 'state') {
+        this.state = channel;
+        channel.onClosed(function () {
+            if (peer.state === channel) { peer.state = null; }
+        });
+    } else if (channel.getLabel() === 'input') {
+        channel.onMessage(function (message) {
+            peer.onInput(message);
+        });
+    }
+};
+
+/**
+ * On input message
+ *
+ * @param {String} message
+ */
+RtcPeer.prototype.onInput = function(message)
+{
+    var events;
+
+    try {
+        events = JSON.parse(message);
+    } catch (error) {
+        return;
+    }
+
+    if (!Array.isArray(events)) { return; }
+
+    events = events.filter(function (event) {
+        return Array.isArray(event) && this.inputEvents.indexOf(event[0]) >= 0;
+    }, this);
+
+    this.client.handleEvents(events);
+};
+
+/**
+ * Is the state channel open?
+ *
+ * @return {Boolean}
+ */
+RtcPeer.prototype.isOpen = function()
+{
+    return this.state !== null && this.state.isOpen();
+};
+
+/**
+ * Queue a state event
+ *
+ * @param {Array} event
+ */
+RtcPeer.prototype.addEvent = function(event)
+{
+    this.events.push(event);
+};
+
+/**
+ * Send queued state events as a single sequenced packet
+ */
+RtcPeer.prototype.flush = function()
+{
+    if (this.events.length > 0) {
+        if (this.isOpen()) {
+            try {
+                this.state.sendMessage(JSON.stringify([++this.sequence, this.events]));
+            } catch (error) {
+                console.error('WebRTC send error: %s', error);
+            }
+        }
+
+        this.events.length = 0;
+    }
+};
+
+/**
+ * Close the peer connection
+ */
+RtcPeer.prototype.close = function()
+{
+    this.state = null;
+    this.events.length = 0;
+
+    if (this.connection) {
+        try {
+            this.connection.close();
+        } catch (error) {
+            console.error('WebRTC close error: %s', error);
+        }
+        this.connection = null;
+    }
+};
