@@ -0,0 +1,77 @@
+/**
+ * Socket connected to a page through worker messages
+ *
+ * @param {Number} id
+ */
+function WorkerServerSocket(id)
+{
+    this.id        = id;
+    this.listeners = {};
+}
+
+WorkerServerSocket.prototype.addEventListener = function(name, callback)
+{
+    (this.listeners[name] = this.listeners[name] || []).push(callback);
+};
+
+WorkerServerSocket.prototype.removeEventListener = function(name, callback)
+{
+    var listeners = this.listeners[name] || [],
+        index     = listeners.indexOf(callback);
+
+    if (index >= 0) { listeners.splice(index, 1); }
+};
+
+WorkerServerSocket.prototype.dispatch = function(name, event)
+{
+    var listeners = (this.listeners[name] || []).slice();
+
+    for (var i = 0; i < listeners.length; i++) {
+        listeners[i](event);
+    }
+};
+
+WorkerServerSocket.prototype.send = function(data)
+{
+    self.postMessage({type: 'message', id: this.id, data: data});
+};
+
+WorkerServerSocket.prototype.ping = function(message, callback)
+{
+    setTimeout(callback, 0);
+};
+
+var offlineClients         = new Collection([], 'id', true),
+    offlineRoomsController = new RoomsController(new RoomRepository()),
+    offlineSockets         = {};
+
+self.onmessage = function(e)
+{
+    var message = e.data,
+        socket  = offlineSockets[message.id],
+        client;
+
+    switch (message.type) {
+        case 'open':
+            socket = offlineSockets[message.id] = new WorkerServerSocket(message.id);
+            client = new SocketClient(socket, 1, 'offline');
+
+            offlineClients.add(client);
+            client.on('close', function () { offlineClients.remove(client); });
+            offlineRoomsController.attach(client);
+
+            self.postMessage({type: 'open', id: message.id});
+            break;
+
+        case 'message':
+            if (socket) { socket.dispatch('message', {data: message.data}); }
+            break;
+
+        case 'close':
+            if (socket) {
+                socket.dispatch('close', {});
+                delete offlineSockets[message.id];
+            }
+            break;
+    }
+};
diff --git a/src/offline/shim.js b/src/offline/shim.js
new file mode 100644
index 0000000..1ddffdc
--- /dev/null
+++ b/src/offline/shim.js
@@ -0,0 +1,86 @@
+/**
+ * Browser stand-ins for the Node.js modules used by the server code, so the game server
+ * can run inside a Web Worker for offline play.
+ */
+function EventEmitter()
+{
+    this._events = {};
+}
+
+EventEmitter.prototype.on = function(name, listener)
+{
+    if (!this._events) { this._events = {}; }
+    (this._events[name] = this._events[name] || []).push(listener);
+
+    return this;
+};
+
+EventEmitter.prototype.addListener = EventEmitter.prototype.on;
+
+EventEmitter.prototype.once = function(name, listener)
+{
+    var emitter = this;
+
+    function wrapper() {
+        emitter.removeListener(name, wrapper);
+        listener.apply(this, arguments);
+    }
+
+    wrapper.listener = listener;
+
+    return this.on(name, wrapper);
+};
+
+EventEmitter.prototype.removeListener = function(name, listener)
+{
+    var listeners = this._events && this._events[name];
+
+    if (listeners) {
+        for (var i = listeners.length - 1; i >= 0; i--) {
+            if (listeners[i] === listener || listeners[i].listener === listener) {
+                listeners.splice(i, 1);
+                break;
+            }
+        }
+    }
+
+    return this;
+};
+
+EventEmitter.prototype.off = EventEmitter.prototype.removeListener;
+
+EventEmitter.prototype.removeAllListeners = function(name)
+{
+    if (typeof(name) === 'undefined') {
+        this._events = {};
+    } else if (this._events) {
+        delete this._events[name];
+    }
+
+    return this;
+};
+
+EventEmitter.prototype.setMaxListeners = function() { return this; };
+
+EventEmitter.prototype.listeners = function(name)
+{
+    return (this._events && this._events[name] || []).slice();
+};
+
+EventEmitter.prototype.emit = function(name)
+{
+    var listeners = this.listeners(name),
+        args      = Array.prototype.slice.call(arguments, 1);
+
+    for (var i = 0; i < listeners.length; i++) {
+        listeners[i].apply(this, args);
+    }
+
+    return listeners.length > 0;
+};
+
+var md5 = false,
+    usage = false,
+    influx = false,
+    nodeDataChannel = false,
+    process = {pid: 0, env: {CURVYTRON_WEBRTC: '0'}};
diff --git a/src/offline/sw.js b/src/offline/sw.js
new file mode 100644
index 0000000..d706868
--- /dev/null
+++ b/src/offline/sw.js
@@ -0,0 +1,46 @@
+/* Service worker: network first, cached app shell when offline. */
+var CACHE  = __CACHE__,
+    ASSETS = __ASSETS__;
+
+self.addEventListener('install', function (e) {
+    self.skipWaiting();
+    e.waitUntil(caches.open(CACHE).then(function (cache) {
+        return Promise.all(ASSETS.map(function (asset) {
+            return cache.add(asset).catch(function () {});
+        }));
+    }));
+});
+
+self.addEventListener('activate', function (e) {
+    e.waitUntil(caches.keys().then(function (keys) {
+        return Promise.all(keys.filter(function (key) { return key !== CACHE; }).map(function (key) {
+            return caches.delete(key);
+        }));
+    }).then(function () {
+        return self.clients.claim();
+    }));
+});
+
+self.addEventListener('fetch', function (e) {
+    var request = e.request;
+
+    if (request.method !== 'GET' || new URL(request.url).origin !== self.location.origin) {
+        return;
+    }
+
+    e.respondWith(fetch(request).then(function (response) {
+        if (response.ok) {
+            var copy = response.clone();
+            caches.open(CACHE).then(function (cache) { cache.put(request, copy); });
+        }
+
+        return response;
+    }).catch(function () {
+        return caches.match(request, {ignoreSearch: true}).then(function (response) {
+            if (response) { return response; }
+            if (request.mode === 'navigate') { return caches.match('./', {ignoreSearch: true}); }
+
+            return Response.error();
+        });
+    }));
+});
