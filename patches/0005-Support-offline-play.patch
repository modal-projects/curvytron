diff --git a/scripts/build-offline.js b/scripts/build-offline.js
new file mode 100644
index 0000000..eea75a3
--- /dev/null
+++ b/scripts/build-offline.js
@@ -0,0 +1,40 @@
+import { readFileSync, writeFileSync, globSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+const root = resolve(__dirname, '..');
+const web = join(root, 'web');
+
+// The game server, run in a Web Worker for offline play.
+const excluded = new Set(['src/server/core/Server.js', 'src/server/core/Inspector.js']);
+const patterns = ['src/offline/shim.js', 'src/shared/**/*.js', 'src/server/*/**/*.js', 'src/offline/main.js'];
+const files = [];
+
+for (const pattern of patterns) {
+    for (const f of globSync(pattern, { cwd: root }).sort()) {
+        if (!excluded.has(f) && !files.includes(f)) { files.push(f); }
+    }
+}
+
+const worker = join(web, 'js', 'offline-server.js');
+writeFileSync(worker, files.map(f => readFileSync(join(root, f), 'utf8')).join('\n'));
+console.log(`Offline server built → ${worker} (${files.length} files)`);
+
+// Service worker precaching the app shell so the game loads without a network.
+const assets = globSync('**/*', { cwd: web, withFileTypes: true })
+    .filter(entry => entry.isFile())
+    .map(entry => join(entry.parentPath, entry.name).slice(web.length + 1))
+    .filter(f => f !== 'sw.js' && f !== 'js/stressTest.js' && f !== 'robots.txt')
+    .sort();
+
+const hash = createHash('sha256');
+for (const f of assets) { hash.update(f).update(readFileSync(join(web, f))); }
+
+const sw = readFileSync(join(root, 'src/offline/sw.js'), 'utf8')
+    .replace('__CACHE__', JSON.stringify('curvytron-' + hash.digest('hex').slice(0, 12)))
+    .replace('__ASSETS__', JSON.stringify(['./', ...assets]));
+
+writeFileSync(join(web, 'sw.js'), sw);
+console.log(`Service worker built → web/sw.js (${assets.length + 1} assets)`);
