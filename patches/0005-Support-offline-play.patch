diff --git a/src/client/core/WorkerSocket.js b/src/client/core/WorkerSocket.js
new file mode 100644
index 0000000..3069941
--- /dev/null
+++ b/src/client/core/WorkerSocket.js
@@ -0,0 +1,63 @@
+/**
+ * WebSocket-like connection to a game server running in a Web Worker (offline play)
+ *
+ * @param {String} url Worker script
+ */
+function WorkerSocket(url)
+{
+    this.id         = 1;
+    this.readyState = 0;
+    this.listeners  = {};
+    this.worker     = new Worker(url);
+
+    this.onWorkerMessage = this.onWorkerMessage.bind(this);
+
+    this.worker.addEventListener('message', this.onWorkerMessage);
+    this.worker.addEventListener('error', this.dispatch.bind(this, 'error'));
+    this.worker.postMessage({type: 'open', id: this.id});
+}
+
+WorkerSocket.prototype.addEventListener = function(name, callback)
+{
+    (this.listeners[name] = this.listeners[name] || []).push(callback);
+};
+
+WorkerSocket.prototype.removeEventListener = function(name, callback)
+{
+    var listeners = this.listeners[name] || [],
+        index     = listeners.indexOf(callback);
+
+    if (index >= 0) { listeners.splice(index, 1); }
+};
+
+WorkerSocket.prototype.dispatch = function(name, event)
+{
+    var listeners = (this.listeners[name] || []).slice();
+
+    for (var i = 0; i < listeners.length; i++) {
+        listeners[i](event);
+    }
+};
+
+WorkerSocket.prototype.onWorkerMessage = function(e)
+{
+    if (e.data.type === 'open') {
+        this.readyState = 1;
+        this.dispatch('open', {});
+    } else if (e.data.type === 'message') {
+        this.dispatch('message', {data: e.data.data});
+    }
+};
+
+WorkerSocket.prototype.send = function(data)
+{
+    this.worker.postMessage({type: 'message', id: this.id, data: data});
+};
+
+WorkerSocket.prototype.close = function()
+{
+    this.worker.postMessage({type: 'close', id: this.id});
+    this.worker.terminate();
+    this.readyState = 3;
+    this.dispatch('close', {});
+};
