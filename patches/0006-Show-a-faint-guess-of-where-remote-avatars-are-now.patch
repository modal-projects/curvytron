 /**
- * Draw the predicted trail of local avatars, between the last server point and the predicted head
+ * Draw the predicted trail of local avatars, between the last server point and the predicted head,
+ * and a faint guess of where remote avatars are at the same moment
  */
 Game.prototype.drawPredictions = function()
 {
+    var context = this.prediction.context;
+
     this.prediction.clear();
 
-    for (var avatar, i = this.avatars.items.length - 1; i >= 0; i--) {
+    for (var avatar, state, i = this.avatars.items.length - 1; i >= 0; i--) {
         avatar = this.avatars.items[i];
 
         if (this.frame && avatar.predictor && avatar.alive && avatar.printing && avatar.predictor.isActive()) {
             this.prediction.drawLineScaled(avatar.predictor.path, avatar.width, avatar.color, 'round');
         }
+
+        if (this.frame && avatar.ghost && avatar.present && avatar.ghost.isActive()) {
+            state = avatar.ghost.predict();
+            context.globalAlpha = avatar.ghost.opacity;
+
+            if (avatar.printing) {
+                this.prediction.drawLineScaled(avatar.ghost.path, avatar.width, avatar.color, 'round');
+            }
+
+            this.prediction.drawCircle(
+                state.x * this.prediction.scale,
+                state.y * this.prediction.scale,
+                avatar.radius * this.prediction.scale,
+                avatar.color
+            );
+            context.globalAlpha = 1;
+        }
     }
 };
 
+/**
+ * Round trip delay (ms) local avatars are predicted ahead by
+ *
+ * @return {Number}
+ */
+Game.prototype.getPredictionDelay = function()
+{
+    for (var avatar, i = this.avatars.items.length - 1; i >= 0; i--) {
+        avatar = this.avatars.items[i];
+
+        if (avatar.predictor && avatar.predictor.delay) {
+            return avatar.predictor.delay;
+        }
+    }
+
+    return this.latency;
+};
+
