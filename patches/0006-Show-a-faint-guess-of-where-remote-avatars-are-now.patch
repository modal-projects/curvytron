index 0000000..a5d3ae4
--- /dev/null
+++ b/src/client/model/AvatarGhost.js
@@ -0,0 +1,150 @@
+/**
+ * Avatar ghost
+ *
+ * Dead reckoning for a remote avatar: its last server state is advanced by the time
+ * since it arrived plus one round trip, the same horizon local avatars are predicted
+ * at, so both are drawn at the same moment of the game.
+ *
+ * @param {Avatar} avatar
+ */
+function AvatarGhost(avatar)
+{
+    this.avatar  = avatar;
+    this.game    = null;
+    this.path    = [];
+    this.server  = null;
+    this.angle   = null;
+    this.angular = 0;
+    this.turned  = false;
+}
+
+/**
+ * Simulation step (ms), the server frame duration
+ *
+ * @type {Number}
+ */
+AvatarGhost.prototype.step = 1000/60;
+
+/**
+ * Maximum extrapolation horizon (ms)
+ *
+ * @type {Number}
+ */
+AvatarGhost.prototype.maxHorizon = 300;
+
+/**
+ * Opacity of the ghost
+ *
+ * @type {Number}
+ */
+AvatarGhost.prototype.opacity = 0.35;
+
+/**
+ * Current time (ms)
+ *
+ * @return {Number}
+ */
+AvatarGhost.prototype.now = function()
+{
+    return window.performance ? window.performance.now() : new Date().getTime();
+};
+
+/**
+ * Reset (new round)
+ */
+AvatarGhost.prototype.reset = function()
+{
+    this.server  = null;
+    this.angle   = null;
+    this.angular = 0;
+    this.turned  = false;
+    this.path.length = 0;
+};
+
+/**
+ * On server angle: the server sends the angle on every frame the avatar turns
+ *
+ * @param {Number} angle
+ */
+AvatarGhost.prototype.onServerAngle = function(angle)
+{
+    var previous = this.angle !== null ? this.angle : this.avatar.angle,
+        delta    = Math.atan2(Math.sin(angle - previous), Math.cos(angle - previous));
+
+    this.angle   = angle;
+    this.turned  = true;
+    this.angular = this.avatar.directionInLoop && delta ? (delta > 0 ? 1 : -1) * this.avatar.angularVelocityBase : 0;
+};
+
+/**
+ * On server position
+ *
+ * @param {Number} x
+ * @param {Number} y
+ */
+AvatarGhost.prototype.onServerPosition = function(x, y)
+{
+    if (!this.turned) {
+        this.angular = 0;
+    }
+
+    this.turned = false;
+    this.server = {
+        x: x,
+        y: y,
+        angle: this.angle !== null ? this.angle : this.avatar.angle,
+        time: this.now()
+    };
+};
+
+/**
+ * Can a guess be made?
+ *
+ * @return {Boolean}
+ */
+AvatarGhost.prototype.isActive = function()
+{
+    return this.server !== null && this.avatar.alive;
+};
+
+/**
+ * Extrapolate the avatar to now, recording the path from its last server position
+ *
+ * @return {Object}
+ */
+AvatarGhost.prototype.predict = function()
+{
+    var avatar   = this.avatar,
+        server   = this.server,
+        delay    = this.game ? this.game.getPredictionDelay() : 0,
+        horizon  = Math.min(this.now() - server.time + delay, this.maxHorizon),
+        velocity = avatar.velocity / 1000,
+        size     = this.game ? this.game.size : null,
+        wrap     = this.game ? this.game.borderless : false,
+        x        = server.x,
+        y        = server.y,
+        angle    = server.angle,
+        time     = 0,
+        dt;
+
+    this.path.length = 0;
+    this.path.push([x, y]);
+
+    while (time < horizon) {
+        dt     = Math.min(this.step, horizon - time);
+        angle += this.angular * dt;
+        x     += Math.cos(angle) * velocity * dt;
+        y     += Math.sin(angle) * velocity * dt;
+
+        if (wrap && size && (x < 0 || x > size || y < 0 || y > size)) {
+            x = (x + size) % size;
+            y = (y + size) % size;
+            this.path.length = 0;
+        }
+
+        this.path.push([x, y]);
+        time += dt;
+    }
+
+    return {x: x, y: y, angle: angle};
+};
